---
import Base from '../layouts/Base.astro';
import EssayCard from '../components/EssayCard.astro';
import Slip from '../components/Slip.astro';
import { SITE } from '../config';
import { getEssays, isPoem, poemLines, topicName } from '../lib/essays';
import { formatDate } from '../lib/format';

const all = await getEssays();
// highlighted post: the newest of everything, essays and poems alike
const [latest] = all;
const KICKER = { kavita: 'ताजी कविता', charoli: 'ताजी चारोळी' } as Record<string, string>;
const latestKicker = latest ? (KICKER[latest.data.topic] ?? 'ताजा लेख') : '';
const latestLines = latest && isPoem(latest) ? poemLines(latest, 6) : [];
// recent list: newest essays and poems together, by date
const RECENT = 8;
const rest = all.filter((e) => e !== latest);
// newest essays, plus every poem, so nothing from चिठ्ठ्या-चपाट्या is missing here
const recent = rest.filter((e, i) => i < RECENT || isPoem(e));
const poems = all.filter((e) => isPoem(e));
---

<Base>
  <div class="page home">
    <section class="intro">
      <h1>नमस्कार, मी {SITE.author}.</h1>
      <p>{SITE.bio}</p>
      <a href="/about/" class="more">अधिक वाचा →</a>
    </section>

    {
      latest && (
        <article class="featured">
          <span class="kicker">{latestKicker} · {topicName(latest.data.topic)} · {formatDate(latest.data.pubDate)}</span>
          <h2>
            <a href={`/essays/${latest.id}/`}>{latest.data.title}</a>
          </h2>
          {latestLines.length > 0 ? (
            <p class="poem-text">
              {latestLines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
            </p>
          ) : (
            latest.data.description && <p>{latest.data.description}</p>
          )}
          <a href={`/essays/${latest.id}/`} class="more">वाचा →</a>
        </article>
      )
    }

    {
      recent.length > 0 && (
        <section id="essays">
          <div class="home-section-head">
            <h2>ताजे लेख आणि कविता</h2>
            <a href="/essays/" class="lnk">सर्व लेख पाहा →</a>
          </div>
          <div class="entry-list">
            {recent.map((essay, i) =>
              isPoem(essay) ? <Slip essay={essay} index={i} /> : <EssayCard essay={essay} index={i} />
            )}
          </div>
        </section>
      )
    }

    {
      poems.length > 0 && (
        <section>
          <div class="home-section-head">
            <h2>चिठ्ठ्या-चपाट्या</h2>
          </div>
          <div class="entry-list">
            {poems.map((essay, i) => (
              <Slip essay={essay} index={i} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>
