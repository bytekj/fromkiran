---
import Base from '../layouts/Base.astro';
import EssayCard from '../components/EssayCard.astro';
import Slip from '../components/Slip.astro';
import { SITE } from '../config';
import { getEssays, isPoem, topicName } from '../lib/essays';
import { formatDate } from '../lib/format';

const all = await getEssays();
const prose = all.filter((e) => !isPoem(e));
const poems = all.filter(isPoem);
const [latest, ...older] = prose;
---

<Base>
  <div class="page home">
    <section class="intro">
      <h1>नमस्कार, मी {SITE.author}.</h1>
      <p>{SITE.bio}</p>
      <a href="/about/" class="more">अधिक वाचा →</a>
    </section>

    {
      latest && (
        <article class="featured">
          <span class="kicker">ताजा लेख · {topicName(latest.data.topic)} · {formatDate(latest.data.pubDate)}</span>
          <h2>
            <a href={`/essays/${latest.id}/`}>{latest.data.title}</a>
          </h2>
          {latest.data.description && <p>{latest.data.description}</p>}
          <a href={`/essays/${latest.id}/`} class="more">वाचा →</a>
        </article>
      )
    }

    {
      older.length > 0 && (
        <section id="essays">
          <div class="home-section-head">
            <h2>आधीचे लेख</h2>
            <a href="/essays/" class="lnk">सर्व लेख पाहा →</a>
          </div>
          <div class="entry-list">
            {older.map((essay, i) => (
              <EssayCard essay={essay} index={i} />
            ))}
          </div>
        </section>
      )
    }

    {
      poems.length > 0 && (
        <section>
          <div class="home-section-head">
            <h2>चिठ्ठ्या-चपाट्या</h2>
          </div>
          <div class="entry-list">
            {poems.map((essay, i) => (
              <Slip essay={essay} index={i} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</Base>
