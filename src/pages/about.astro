---
import Base from '../layouts/Base.astro';
import { SITE, TOPICS } from '../config';
import { getEssays } from '../lib/essays';
import { formatDate } from '../lib/format';

const TOPIC_SLUG = 'manatlya-goshti';
const topicName = TOPICS.find((t) => t.slug === TOPIC_SLUG)?.name ?? '';
const essays = (await getEssays()).filter((e) => e.data.topic === TOPIC_SLUG);
---

<Base title="माझ्याबद्दल" description={SITE.bio}>
  <div class="page">
    <div class="row">
      <section class="tile tile-accent tile-wide" style="padding: clamp(28px, 4vw, 48px);">
        <h1 style="font-weight: 700; font-size: clamp(32px, 4.4vw, 52px); line-height: 1.4;">
          नमस्कार, मी {SITE.author}.
        </h1>
        <p style="font-size: 20px; line-height: 1.9; max-width: 640px;">{SITE.bio}</p>
        <!-- Write more about yourself here. -->
      </section>
      <section class="tile tile-photo">
        {
          SITE.photo ? (
            <img src={SITE.photo} alt={SITE.author} width="1000" height="1333" />
          ) : (
            <div class="photo photo-placeholder">तुमचा<br />फोटो</div>
          )
        }
      </section>
    </div>

    <section class="tile tile-mint" style="flex: none;">
      <h2>
        <a href={`/topics/${TOPIC_SLUG}/`}>{topicName}</a>
      </h2>
      {
        essays.length > 0 ? (
          <ul class="essay-list">
            {essays.map((essay) => (
              <li>
                <a href={`/essays/${essay.id}/`}>{essay.data.title}</a>
                <span class="date">{formatDate(essay.data.pubDate)}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p>अजून लेख नाहीत.</p>
        )
      }
    </section>
  </div>
</Base>
