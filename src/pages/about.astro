---
import Base from '../layouts/Base.astro';
import { SITE, TOPICS } from '../config';
import { getEssays } from '../lib/essays';
import { formatDate } from '../lib/format';

const TOPIC_SLUG = 'manatlya-goshti';
const topicName = TOPICS.find((t) => t.slug === TOPIC_SLUG)?.name ?? '';
const essays = (await getEssays()).filter((e) => e.data.topic === TOPIC_SLUG);
---

<Base title="माझ्याबद्दल" description={SITE.bio}>
  <div class="page about">
    <section>
      <h1>नमस्कार, मी {SITE.author}.</h1>
      <p class="about-bio">{SITE.bio}</p>
      <!-- Write more about yourself here. -->
    </section>

    <section>
      <div class="home-section-head">
        <h2>
          <a href={`/topics/${TOPIC_SLUG}/`}>{topicName}</a>
        </h2>
      </div>
      {
        essays.length > 0 ? (
          <div class="entry-list">
            {essays.map((essay) => (
              <article class="entry">
                <span class="entry-date">{formatDate(essay.data.pubDate)}</span>
                <h3 class="entry-title">
                  <a href={`/essays/${essay.id}/`}>{essay.data.title}</a>
                </h3>
              </article>
            ))}
          </div>
        ) : (
          <p>अजून लेख नाहीत.</p>
        )
      }
    </section>
  </div>
</Base>
