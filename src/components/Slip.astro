---
import type { Essay } from '../lib/essays';
import { topicName, poemLines } from '../lib/essays';
import { formatDate } from '../lib/format';

interface Props {
  essay: Essay;
  index?: number;
}

const { essay } = Astro.props;
const lines = poemLines(essay);
---

<article class="entry">
  <span class="entry-date">{formatDate(essay.data.pubDate)}</span>
  <div>
    <h3 class="entry-title"><a href={`/essays/${essay.id}/`}>{essay.data.title}</a></h3>
    <p class="poem-text">
      {lines.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
    </p>
    <span class="entry-topic">{topicName(essay.data.topic)}</span>
  </div>
</article>
